# Environment variables for Pusiknas module

PUSIKNAS_BASE=https://pusiknas.polri.go.id
CACHE_TTL=3600

# PowerBI "publish to web" resource key powering /api/pusiknas (required).
PUSIKNAS_POWERBI_RESOURCE_KEY=

# Optional /api/pusiknas tuning (defaults shown)
# PUSIKNAS_POWERBI_URL=https://wabi-south-east-asia-b-primary-api.analysis.windows.net/public/reports/querydata?synchronous=true
# PUSIKNAS_CACHE_TTL=60
# PUSIKNAS_RATE_LIMIT_WINDOW=60
# PUSIKNAS_RATE_LIMIT_MAX=60
# PUSIKNAS_DEBUG=true
